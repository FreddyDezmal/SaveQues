# Copy this file to .env.local and fill in your Supabase credentials
# Get these from: https://supabase.com → Your Project → Settings → API

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# ── Analytics (PostHog) ────────────────────────────────────────────────────────
# Get these from: https://app.posthog.com → Project → Settings → Project API key
#
# NEXT_PUBLIC_POSTHOG_KEY  — used by the browser (posthog-js)
# POSTHOG_KEY              — used by the server (posthog-node, API routes)
# Both should be the same PostHog project key.
#
# Leave blank to disable analytics entirely (safe for local dev).
NEXT_PUBLIC_POSTHOG_KEY=phc_your_project_key_here
NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com
POSTHOG_KEY=phc_your_project_key_here
POSTHOG_HOST=https://app.posthog.com