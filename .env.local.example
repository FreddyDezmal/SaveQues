# Copy this file to .env.local and fill in your Supabase credentials
# Get these from: https://supabase.com → Your Project → Settings → API

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# ── Analytics (PostHog) ────────────────────────────────────────────────────────
# Get these from: https://app.posthog.com → Project → Settings → Project API key
#
# NEXT_PUBLIC_POSTHOG_KEY  — used by the browser (posthog-js)
# POSTHOG_KEY              — used by the server (posthog-node, API routes)
# Both should be the same PostHog project key.
#
# Leave blank to disable analytics entirely (safe for local dev).
NEXT_PUBLIC_POSTHOG_KEY=phc_your_project_key_here
NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com
POSTHOG_KEY=phc_your_project_key_here
POSTHOG_HOST=https://app.posthog.com

# ── Web Push / VAPID ───────────────────────────────────────────────────────────
# Generate with: node scripts/generate-vapid-keys.mjs
NEXT_PUBLIC_VAPID_PUBLIC_KEY=your_vapid_public_key_here
VAPID_PRIVATE_KEY=your_vapid_private_key_here
VAPID_SUBJECT=mailto:admin@savequest.app

# ── Cron job secret ────────────────────────────────────────────────────────────
# Protects GET /api/cron/notifications from unauthorised access
# Set the same value as the Authorization: Bearer header in your cron service
CRON_SECRET=your_random_secret_here
# ── Error monitoring (Sentry) ──────────────────────────────────────────────────
# Get DSN from: https://sentry.io → Project → Settings → Client Keys (DSN)
# NEXT_PUBLIC_SENTRY_DSN is used by the browser; SENTRY_DSN by the server.
# Both should be the same Sentry project DSN.
# Leave blank to disable Sentry (safe for local dev).
NEXT_PUBLIC_SENTRY_DSN=https://your-sentry-dsn@sentry.io/your-project-id
SENTRY_DSN=https://your-sentry-dsn@sentry.io/your-project-id
SENTRY_ORG=your-sentry-org-slug
SENTRY_PROJECT=savequest

# ── Email provider (Sprint 27, Phase 9) ─────────────────────────────────────────
# Leave EMAIL_PROVIDER unset to disable email entirely (safe for local dev, and
# the default in this project — no provider is configured anywhere). See
# lib/email/index.ts and docs/SPRINT27_PHASE9_EMAIL_PROVIDER_ARCHITECTURE.md.
# EMAIL_PROVIDER=resend
# EMAIL_FROM_ADDRESS=notifications@yourdomain.com
# RESEND_API_KEY=your_resend_api_key_here
# SENDGRID_API_KEY=your_sendgrid_api_key_here
# POSTMARK_SERVER_TOKEN=your_postmark_server_token_here
# MAILGUN_API_KEY=your_mailgun_api_key_here
# MAILGUN_DOMAIN=mg.yourdomain.com
# SES not usable yet — providers/ses.ts is a documented stub, not a working
# adapter (AWS SigV4 signing needs the @aws-sdk/client-sesv2 package).
# SES_ACCESS_KEY_ID=
# SES_SECRET_ACCESS_KEY=
# SES_REGION=

# ── Push provider (Sprint 27, Phase 10) ──────────────────────────────────────────
# Leave PUSH_PROVIDER unset (or "webpush") to keep using the standards-based Web
# Push implementation above — that's the default AND the only one actually
# integrated in this project today. See lib/push/index.ts and
# docs/SPRINT27_PHASE10_PUSH_PROVIDER_ARCHITECTURE.md.
# PUSH_PROVIDER=webpush
# FIREBASE_PROJECT_ID=your-firebase-project-id
# FIREBASE_SERVICE_ACCOUNT_EMAIL=firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
# ONESIGNAL_API_KEY=your_onesignal_rest_api_key_here
# ONESIGNAL_APP_ID=your_onesignal_app_id_here
# EXPO_ACCESS_TOKEN=
# APNs not usable yet — providers/apns.ts's send() is a documented stub (APNs
# requires HTTP/2, which plain fetch() cannot do). The JWT builder is real.
# APNS_TEAM_ID=
# APNS_KEY_ID=
# APNS_PRIVATE_KEY=
# APNS_TOPIC=
# APNS_PRODUCTION=false

# ── Exchange rate provider (Sprint 31, Phase 6) ──────────────────────────────────
# Leave EXCHANGE_RATE_PROVIDER unset (or "identity") to serve 1:1 rates for every
# currency — the safe default, since no currency conversion feature reads these
# rates yet (see lib/exchangeRates/providers/identity.ts). Set both vars below to
# enable real daily-refreshed rates via exchangerate-api.com's free tier.
# EXCHANGE_RATE_PROVIDER=exchangerate_api
# EXCHANGE_RATE_API_KEY=your_exchangerate_api_key_here

